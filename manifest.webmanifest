{
  "name": "BIN - trash identifier",
  "short_name": "BIN",
  "description": "Take a photo of one piece of trash: BIN identifies its material and tells you which bin it belongs in. Runs on your phone.",
  "start_url": "./#/scan",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F5F7EF",
  "theme_color": "#498428",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/logo.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
